{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetCalc",
  "version": "1.0.0",
  "identifier": "com.netcalc.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "NetCalc - Personal Finance & Savings Tracker",
        "width": 1050,
        "height": 720,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true,
        "backgroundColor": "#0b0f19"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
